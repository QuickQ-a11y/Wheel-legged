{
    // 一份通吃 Windows 和 Linux：全局 options 是 Linux 的，windows 平台节整段覆盖它。
    // 工具链不在系统 PATH 上，靠 options.env 临时补进去；
    // PATH 分隔符 Linux 是 :、Windows 是 ;，两段各写各的。
    //
    // 烧录有两条路：OpenOCD（openocd.cfg）和 J-Link Commander（flash.jlink），
    // 两者都不进调试器，用哪个看你手上的调试器。
    //
    // 版本号跟着 STM32 VSCode 扩展 bundle manager 实际下载的版本走，
    // 与本机 bundles 目录下的文件夹名不一致时，改下面两段 PATH 里的版本号。
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "env": {
            "PATH": "${env:HOME}/.local/share/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin:${env:HOME}/.local/share/stm32cube/bundles/ninja/1.13.2+st.1/bin:${env:PATH}"
        }
    },
    "windows": {
        "options": {
            "env": {
                "PATH": "${env:LOCALAPPDATA}\\stm32cube\\bundles\\gnu-tools-for-stm32\\14.3.1+st.2\\bin;${env:LOCALAPPDATA}\\stm32cube\\bundles\\ninja\\1.13.2+st.1\\bin;${env:PATH}"
            }
        }
    },
    "tasks": [
        {
            "label": "编译",
            "type": "shell",
            "command": "cmake --build build/Debug",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "group": "build"
        },
        {
            "label": "烧录 (OpenOCD)",
            "type": "shell",
            "command": "openocd -f openocd.cfg -c \"program build/Debug/Wheel-legged.elf verify reset exit\"",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            // 串联而不是用 dependsOn：VS Code 的 dependsOn 序列在前一个任务
            // 失败时仍会继续，那样会把上一次的旧 elf 烧进去。
            // Windows 单独写一份：默认 shell 是 PowerShell 5.1，不支持 &&（PS 7 才有），
            // 用 $LASTEXITCODE 判断上一条原生命令的退出码，$? 对原生命令不可靠。
            "label": "编译 + 烧录 (OpenOCD)",
            "type": "shell",
            "command": "cmake --build build/Debug && openocd -f openocd.cfg -c \"program build/Debug/Wheel-legged.elf verify reset exit\"",
            "windows": {
                "command": "cmake --build build/Debug; if ($LASTEXITCODE -eq 0) { openocd -f openocd.cfg -c \"program build/Debug/Wheel-legged.elf verify reset exit\" }"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            // J-Link 命令行工具 Linux 叫 JLinkExe、Windows 叫 JLink.exe，
            // 且 Windows 默认装在带空格的 Program Files 下，所以整条命令单独覆盖。
            "label": "烧录 (J-Link)",
            "type": "shell",
            "command": "JLinkExe -device STM32H723VG -if SWD -speed 4000 -autoconnect 1 -CommanderScript flash.jlink",
            "windows": {
                "command": "& 'C:/Program Files/SEGGER/JLink/JLink.exe' -device STM32H723VG -if SWD -speed 4000 -autoconnect 1 -CommanderScript flash.jlink"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "编译 + 烧录 (J-Link)",
            "type": "shell",
            "command": "cmake --build build/Debug && JLinkExe -device STM32H723VG -if SWD -speed 4000 -autoconnect 1 -CommanderScript flash.jlink",
            "windows": {
                "command": "cmake --build build/Debug; if ($LASTEXITCODE -eq 0) { & 'C:/Program Files/SEGGER/JLink/JLink.exe' -device STM32H723VG -if SWD -speed 4000 -autoconnect 1 -CommanderScript flash.jlink }"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        // ── 以下是 Release（-Os）。量执行耗时必须用这一组 ────────────────────
        //
        // Debug 是 -O0，Eigen 模板完全不优化：Release 的 text 是 143 KB，
        // Debug 是 503 KB，差 3.5 倍，基本都是 Eigen。拿 Debug 量 MPC 求解
        // 耗时不但没有参考价值，而且危险——commit 3caf81a 就是 Debug 下单次
        // 求解撑爆 1 kHz 周期，任务卡住导致 CAN 停发、DM 保持最后力矩、
        // 遥控断不了电。
        //
        // build/Release 与 build/Debug 是两个独立目录，互不影响，可以来回切。
        // 首次使用前要先配置一次：cmake --preset Release
        {
            "label": "编译 (Release)",
            "type": "shell",
            "command": "cmake --build build/Release",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "group": "build"
        },
        {
            "label": "烧录 (OpenOCD, Release)",
            "type": "shell",
            "command": "openocd -f openocd.cfg -c \"program build/Release/Wheel-legged.elf verify reset exit\"",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "编译 + 烧录 (OpenOCD, Release)",
            "type": "shell",
            "command": "cmake --build build/Release && openocd -f openocd.cfg -c \"program build/Release/Wheel-legged.elf verify reset exit\"",
            "windows": {
                "command": "cmake --build build/Release; if ($LASTEXITCODE -eq 0) { openocd -f openocd.cfg -c \"program build/Release/Wheel-legged.elf verify reset exit\" }"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            // J-Link Commander 的 elf 路径写在脚本里，所以 Release 单独一份
            // flash_release.jlink，不能和 Debug 共用 flash.jlink。
            "label": "烧录 (J-Link, Release)",
            "type": "shell",
            "command": "JLinkExe -device STM32H723VG -if SWD -speed 4000 -autoconnect 1 -CommanderScript flash_release.jlink",
            "windows": {
                "command": "& 'C:/Program Files/SEGGER/JLink/JLink.exe' -device STM32H723VG -if SWD -speed 4000 -autoconnect 1 -CommanderScript flash_release.jlink"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "编译 + 烧录 (J-Link, Release)",
            "type": "shell",
            "command": "cmake --build build/Release && JLinkExe -device STM32H723VG -if SWD -speed 4000 -autoconnect 1 -CommanderScript flash_release.jlink",
            "windows": {
                "command": "cmake --build build/Release; if ($LASTEXITCODE -eq 0) { & 'C:/Program Files/SEGGER/JLink/JLink.exe' -device STM32H723VG -if SWD -speed 4000 -autoconnect 1 -CommanderScript flash_release.jlink }"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
